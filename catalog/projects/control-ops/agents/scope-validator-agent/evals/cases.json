{
  "agent_id": "control-ops.scope-validator-agent",
  "cases": [
    {
      "id": "safe-read-action",
      "tags": [
        "happy-path"
      ],
      "input": {
        "action_description": "Read user preferences from the settings API",
        "permissions_requested": [
          "settings:read"
        ],
        "reversibility_plan": "Read-only, no changes needed",
        "scope_boundary": "User settings service only"
      },
      "expected_output": {
        "verdict": "pass",
        "findings": [
          "Scope boundary is explicit: User settings service only",
          "Reversibility plan present: Read-only, no changes needed"
        ],
        "risk_level": "low"
      },
      "assertions": [
        {
          "field": "verdict",
          "op": "eq",
          "value": "pass"
        },
        {
          "field": "risk_level",
          "op": "eq",
          "value": "low"
        }
      ]
    },
    {
      "id": "destructive-no-plan",
      "tags": [
        "edge-case"
      ],
      "input": {
        "action_description": "Delete all archived user records from production",
        "permissions_requested": [
          "db:delete",
          "admin:write",
          "pii:access"
        ],
        "reversibility_plan": "",
        "scope_boundary": ""
      },
      "expected_output": {
        "verdict": "fail",
        "findings": [
          "Scope boundary is missing; action has unbounded reach",
          "Reversibility plan missing for destructive action",
          "Sensitive permissions requested: admin:write, pii:access"
        ],
        "risk_level": "high"
      },
      "assertions": [
        {
          "field": "verdict",
          "op": "eq",
          "value": "fail"
        },
        {
          "field": "risk_level",
          "op": "eq",
          "value": "high"
        }
      ]
    },
    {
      "id": "destructive-with-plan",
      "tags": [
        "edge-case"
      ],
      "input": {
        "action_description": "Remove stale cache entries from Redis cluster",
        "permissions_requested": [
          "cache:delete"
        ],
        "reversibility_plan": "Cache auto-repopulates within 5 minutes",
        "scope_boundary": "Redis staging cluster only"
      },
      "expected_output": {
        "verdict": "review",
        "findings": [
          "Scope boundary is explicit: Redis staging cluster only",
          "Reversibility plan present: Cache auto-repopulates within 5 minutes"
        ],
        "risk_level": "medium"
      },
      "assertions": [
        {
          "field": "verdict",
          "op": "eq",
          "value": "review"
        },
        {
          "field": "risk_level",
          "op": "in",
          "value": [
            "medium",
            "high"
          ]
        }
      ]
    },
    {
      "id": "update-medium-risk",
      "tags": [
        "boundary"
      ],
      "input": {
        "action_description": "Update feature flag for dark mode rollout",
        "permissions_requested": [
          "flags:write"
        ],
        "scope_boundary": "Feature flag service"
      },
      "expected_output": {
        "verdict": "pass",
        "findings": [
          "Scope boundary is explicit: Feature flag service",
          "No reversibility plan provided"
        ],
        "risk_level": "medium"
      },
      "assertions": [
        {
          "field": "risk_level",
          "op": "eq",
          "value": "medium"
        }
      ]
    }
  ]
}
