{
  "agent_id": "support-ops.summary-agent",
  "cases": [
    {
      "id": "mixed-tickets",
      "tags": [
        "happy-path"
      ],
      "input": {
        "period_start": "2026-03-01",
        "period_end": "2026-03-07",
        "tickets": [
          {
            "priority": "p1",
            "category": "access"
          },
          {
            "priority": "p2",
            "category": "access"
          },
          {
            "priority": "p3",
            "category": "billing"
          },
          {
            "priority": "p4",
            "category": "bug"
          },
          {
            "priority": "p2",
            "category": "access"
          }
        ],
        "top_n_actions": 3
      },
      "expected_output": {
        "ticket_count": 5,
        "priority_breakdown": {
          "p1": 1,
          "p2": 2,
          "p3": 1,
          "p4": 1
        },
        "top_categories": [
          "access:3",
          "billing:1",
          "bug:1"
        ],
        "summary": "Support volume from 2026-03-01 to 2026-03-07: 5 tickets. Top category: access. Priority mix p1=1, p2=2, p3=1, p4=1.",
        "recommended_actions": [
          "Run a brief incident review for p1 themes and preventive controls",
          "Publish one trend note with priority shifts and customer impact",
          "Select one recurring issue and define mitigation experiment"
        ]
      },
      "assertions": [
        {
          "field": "ticket_count",
          "op": "eq",
          "value": 5
        },
        {
          "field": "priority_breakdown",
          "op": "has_keys",
          "value": [
            "p1",
            "p2",
            "p3",
            "p4"
          ]
        },
        {
          "field": "top_categories",
          "op": "min_length",
          "value": 1
        },
        {
          "field": "recommended_actions",
          "op": "length",
          "value": 3
        }
      ]
    },
    {
