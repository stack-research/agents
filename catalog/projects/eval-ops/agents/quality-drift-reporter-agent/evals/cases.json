{
  "agent_id": "eval-ops.quality-drift-reporter-agent",
  "cases": [
    {
      "id": "degrading-series",
      "tags": ["drift"],
      "input": {
        "metric_name": "accuracy",
        "windows": [
          {"window_label": "d1", "score": 0.9},
          {"window_label": "d2", "score": 0.88},
          {"window_label": "d3", "score": 0.7}
        ]
      },
      "assertions": [
        {"field": "trend", "op": "eq", "value": "degrading"},
        {"field": "drift_severity", "op": "in", "value": ["low", "medium", "high"]}
      ]
    }
  ]
}
